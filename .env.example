# ─── SENTINEL DASHBOARD — API Keys ───────────────────────────────────────────
# Copy this file to .env and fill in your keys.
# The app works without keys using rich demo data.

# GNews API — https://gnews.io (100 req/day free)
GNEWS_API_KEY=

# OpenWeatherMap — https://openweathermap.org (1000 req/day free, used for AQI)
OPENWEATHER_API_KEY=

# ─── Weather Monitor Configuration ─────────────────────────────────────────────
# Open-Meteo works without keys on free tier.
# Optional Commercial API Key for high volume or dedicated egress:
OPEN_METEO_API_KEY=
# Cache TTL in ms (default: 15 minutes = 900000 ms to protect against 429 rate limits)
WEATHER_CACHE_TTL_MS=900000

# ─── Telegram Official API Configuration ───────────────────────────────────────
# Telegram API Credentials (shared between local and production)
# Obtain from https://my.telegram.org -> API Development Tools
TELEGRAM_API_ID=
TELEGRAM_API_HASH=

# Runtime Environment ('local' or 'production')
# Render automatically detects production. For localhost development, default is 'local'.
TELEGRAM_ENVIRONMENT=local

# Isolated MTProto Sessions:
# NEVER use the same session/auth key simultaneously on localhost and Render.
# Using identical session keys on different machines causes 406: AUTH_KEY_DUPLICATED.
TELEGRAM_SESSION_LOCAL=
TELEGRAM_SESSION_PRODUCTION=

# Optional Bot Token fallback if MTProto user session is not available
TELEGRAM_BOT_TOKEN=

# Channel Monitoring Settings
TELEGRAM_CHANNELS=koridorsrb,srpskinat,istokinfo
TELEGRAM_LIMIT_PER_CHANNEL=10
TELEGRAM_CACHE_TTL_MS=60000

# ─── Border Monitor ────────────────────────────────────────────────────────────
# Primary: QKMK Kosovo Official Portal, Secondary: Nakordoni Developer API
BORDER_API_URL=https://mpb.rks-gov.net/?culture=sr-latn-rs
BORDER_CACHE_TTL_MS=60000
NAKORDONI_API_KEY=

# ─── Server Configuration ──────────────────────────────────────────────────────
PORT=3000
POLL_INTERVAL_MS=300000
