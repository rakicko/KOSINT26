# ─── SENTINEL DASHBOARD — API Keys ───────────────────────────────────────────
# Copy this file to .env and fill in your keys.
# The app works without keys using rich demo data.

# GNews API — https://gnews.io (100 req/day free)
GNEWS_API_KEY=

# OpenWeatherMap — https://openweathermap.org (1000 req/day free, used for AQI)
OPENWEATHER_API_KEY=

# Telegram Monitor (Official Bot Token or Public Channel Web Ingestion)
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHANNELS=koridorsrb,srpskinat,istokinfo
TELEGRAM_LIMIT_PER_CHANNEL=10
TELEGRAM_CACHE_TTL_MS=60000

# Border Monitor (Primary: QKMK Kosovo Official Portal, Secondary: Nakordoni Developer API)
BORDER_API_URL=https://mpb.rks-gov.net/?culture=sr-latn-rs
BORDER_CACHE_TTL_MS=60000
NAKORDONI_API_KEY=
# NAKORDONI_API_URL=https://nakordoni.eu
# NAKORDONI_KOSOVO_PPIDS=id_512,id_513,id_530,id_531,id_560,id_561,id_564,id_565,id_566,id_567,id_568,id_569,id_592,id_593,id_594,id_595

# Server & Security config
PORT=3000
NODE_ENV=development
POLL_INTERVAL_MS=300000
ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000


